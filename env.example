# Backend
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/okuz_ai"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your-super-secret-jwt-key-with-at-least-32-chars________"
JWT_REFRESH_SECRET="your-refresh-secret-with-at-least-32-chars_______"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
BCRYPT_SALT_ROUNDS=12
THROTTLER_SHORT_TTL=60000
THROTTLER_SHORT_LIMIT=5
THROTTLER_MEDIUM_TTL=60000
THROTTLER_MEDIUM_LIMIT=20
THROTTLER_LONG_TTL=60000
THROTTLER_LONG_LIMIT=100
SWAGGER_ENABLE=true
PROMETHEUS_PORT=9464

# AI Providers
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="your-gemini-api-key-here"

# Frontend
REACT_APP_API_URL="http://localhost:3000"
REACT_APP_WS_URL="http://localhost:3000/realtime"

# Observability
SENTRY_DSN=""
LOG_TO_DATABASE=false 