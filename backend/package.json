{
  "name": "okuz-api",
  "version": "0.0.1",
  "description": "AI-powered learning platform API",
  "author": "Okuz AI Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:ci": "jest --coverage --detectOpenHandles --forceExit --ci",
    "test:setup": "./test/scripts/run-tests.sh setup",
    "test:cleanup": "./test/scripts/run-tests.sh cleanup",
    "test:all": "./test/scripts/run-tests.sh all",
    "test:check-coverage": "./test/scripts/run-tests.sh coverage",
    "ai:test": "jest --testPathPattern=ai",
    "ai:test:prompts": "jest --testPathPattern=ai/prompts",
    "ai:test:templates": "jest --testPathPattern=ai/templates",
    "ai:benchmark": "node scripts/ai-benchmark.js",
    "ai:monitor": "node scripts/ai-monitor.js",
    "ai:cost-analysis": "node scripts/ai-cost-analysis.js",
    "ai:health-check": "node scripts/ai-health-check.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "dev": "npm run docker:up && npm run start:dev",
    "prod": "npm run build && npm run start:prod",
    "clean": "rm -rf dist coverage .jest-cache",
    "prepare": "husky install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^10.4.20",
    "@opentelemetry/auto-instrumentations-node": "^0.65.0",
    "@opentelemetry/exporter-jaeger": "^2.1.0",
    "@opentelemetry/exporter-zipkin": "^2.1.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@prisma/client": "^6.17.1",
    "@sentry/node": "^8.20.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^4.15.4",
    "cache-manager": "^7.2.4",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "crypto": "^1.0.1",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "html-pdf": "^3.0.1",
    "ioredis": "^5.3.2",
    "joi": "^18.0.1",
    "msw": "^2.0.0",
    "nock": "^13.4.0",
    "nodemailer": "^7.0.7",
    "openai": "^6.1.0",
    "opossum": "^9.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.17.1",
    "prom-client": "^15.1.3",
    "redis": "^5.8.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "supertest": "^6.3.3",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.20",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.17",
    "@types/html-pdf": "^3.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^7.0.2",
    "@types/passport-jwt": "^3.0.9",
    "@types/supertest": "^2.0.12",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
