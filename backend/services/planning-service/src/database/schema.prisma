// Planning Service Database Schema
// This schema is specific to the Planning Service and contains only planning-related entities

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLANNING_DATABASE_URL")
}

// User entity (minimal user data for planning service)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  plans     Plan[]
  sessions  StudySession[]
  progress  Progress[]

  @@map("users")
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

// Plan entity
model Plan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  subjects    String[]
  goals       String[]
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  planType    PlanType @default(WEEKLY)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions StudySession[]
  progress Progress[]

  @@map("plans")
}

enum PlanType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

// Study Session entity
model StudySession {
  id          String   @id @default(cuid())
  planId      String
  userId      String
  subject     String
  topic       String
  duration    Int      // in minutes
  startTime   DateTime
  endTime     DateTime
  isCompleted Boolean  @default(false)
  difficulty  DifficultyLevel @default(INTERMEDIATE)
  sessionType SessionType @default(STUDY)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  plan    Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@map("study_sessions")
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SessionType {
  STUDY
  PRACTICE
  REVIEW
  EXAM
}

// Progress entity
model Progress {
  id          String   @id @default(cuid())
  userId      String
  planId      String
  sessionId   String?
  score       Float?
  timeSpent   Int      // in minutes
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  session StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("progress")
}

// Plan Template entity (for reusable plan templates)
model PlanTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  subjects    String[]
  goals       String[]
  duration    Int      // in days
  difficulty  DifficultyLevel @default(INTERMEDIATE)
  isPublic    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plan_templates")
}

// Plan Analytics entity (for storing analytics data)
model PlanAnalytics {
  id                String   @id @default(cuid())
  planId            String
  userId            String
  completionRate    Float
  averageScore      Float
  totalStudyTime    Int      // in minutes
  sessionsCompleted Int
  sessionsSkipped   Int
  weakAreas         String[]
  strongAreas        String[]
  recommendations   String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("plan_analytics")
}

// Plan Optimization entity (for storing optimization results)
model PlanOptimization {
  id              String   @id @default(cuid())
  planId          String
  originalScore   Float
  optimizedScore  Float
  improvements    String[]
  optimizationType String
  createdAt       DateTime @default(now())

  @@map("plan_optimizations")
}

// Plan Validation entity (for storing validation results)
model PlanValidation {
  id          String   @id @default(cuid())
  planId      String
  isValid     Boolean
  errors      String[]
  warnings    String[]
  suggestions String[]
  createdAt   DateTime @default(now())

  @@map("plan_validations")
}

// Plan Events entity (for event sourcing)
model PlanEvent {
  id        String   @id @default(cuid())
  planId    String
  eventType String
  eventData Json
  timestamp DateTime @default(now())

  @@map("plan_events")
}

// Plan Statistics entity (for storing aggregated statistics)
model PlanStatistics {
  id                    String   @id @default(cuid())
  userId                String
  totalPlans            Int      @default(0)
  completedPlans        Int      @default(0)
  totalStudyTime        Int      @default(0) // in minutes
  averageCompletionRate Float    @default(0)
  favoriteSubjects      String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("plan_statistics")
}
