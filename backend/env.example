# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/okuz_ai"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here"
JWT_ACCESS_TOKEN_EXPIRATION="1h"
JWT_REFRESH_TOKEN_EXPIRATION="24h"

# Password Security
BCRYPT_SALT_ROUNDS=12

# Server
PORT=3002
NODE_ENV=development

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Rate Limiting (Throttler)
THROTTLER_SHORT_TTL=60000
THROTTLER_SHORT_LIMIT=5
THROTTLER_MEDIUM_TTL=60000
THROTTLER_MEDIUM_LIMIT=20
THROTTLER_LONG_TTL=60000
THROTTLER_LONG_LIMIT=100

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here" 