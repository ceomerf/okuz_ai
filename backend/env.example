# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5433/okuz_ai"
REDIS_URL="redis://localhost:6379"

# JWT Configuration (MUST be at least 32 characters)
JWT_SECRET="your-super-secret-jwt-key-here-minimum-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here-minimum-32-chars"
JWT_ACCESS_TOKEN_EXPIRATION="1h"
JWT_REFRESH_TOKEN_EXPIRATION="7d"

# Password Security
BCRYPT_SALT_ROUNDS=12

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration (REQUIRED - comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://app.okuz.ai"

# Rate Limiting (Throttler)
THROTTLER_SHORT_TTL=60000
THROTTLER_SHORT_LIMIT=5
THROTTLER_MEDIUM_TTL=60000
THROTTLER_MEDIUM_LIMIT=20
THROTTLER_LONG_TTL=60000
THROTTLER_LONG_LIMIT=100

# AI Services
OPENAI_API_KEY="your-openai-api-key-here"

# External Integrations
EXTERNAL_API_KEY="dev_api_key"
STRIPE_WEBHOOK_SECRET="dev_stripe"
IYZICO_WEBHOOK_SECRET="dev_iyzico"

# Monitoring (Optional)
PROMETHEUS_PORT=9090
SWAGGER_ENABLE=true

# Security Configuration
ENCRYPTION_KEY="your-encryption-key-here-minimum-32-chars"
PGPASSWORD="your_database_password"

# Rate Limiting
RATE_LIMIT_TTL=3600
RATE_LIMIT_LIMIT=100

# Backup Configuration
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# Feature Flags
FEATURE_FLAGS_CACHE_TTL=300

# Machine Learning
ML_MODEL_CACHE_TTL=600
ML_PREDICTION_TIMEOUT=5000

# Reporting
REPORT_GENERATION_TIMEOUT=30000
REPORT_STORAGE_PATH="./reports"

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_BATCH_SIZE=100

# Performance Monitoring
PERFORMANCE_METRICS_INTERVAL=60000
PERFORMANCE_ALERT_THRESHOLD=80

# User Activity Tracking
ACTIVITY_TRACKING_ENABLED=true
ACTIVITY_SESSION_TIMEOUT=1800000

# Data Export
EXPORT_BATCH_SIZE=1000
EXPORT_TIMEOUT=300000 