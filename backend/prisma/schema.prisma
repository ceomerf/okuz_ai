// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  STUDENT
  PARENT
  TEACHER
  COACH
  ADMIN
}

enum PlanType {
  DAILY
  WEEKLY
  MONTHLY
  HOLIDAY
  LONG_TERM
}

enum AchievementType {
  STUDY_STREAK
  PERFECT_SCORE
  COMPLETION
  MILESTONE
  SPECIAL
}

enum TaskType {
  STUDY_SESSION
  QUIZ
  EXAM
  PROJECT
  READING
  PRACTICE
}

enum NotificationType {
  REMINDER
  ACHIEVEMENT
  PROGRESS
  SYSTEM
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationCategory {
  SYSTEM
  USER
  PAYMENT
  LEARNING
  SECURITY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
  TRIAL
  PREMIUM
  FREE
  FAMILY
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PROFILE_UPDATE
  SUSPICIOUS_ACTIVITY
  BRUTE_FORCE_ATTEMPT
  UNAUTHORIZED_ACCESS
}

enum SecurityThreatLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIServiceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DEPRECATED
}

enum SubscriptionPlan {
  MONTHLY_PREMIUM
  YEARLY_PREMIUM
  FAMILY_PLAN
  FREE
  TRIAL
}

enum AIModelType {
  TEXT_GENERATION
  TEXT_ANALYSIS
  IMAGE_GENERATION
  IMAGE_ANALYSIS
  SPEECH_TO_TEXT
  TEXT_TO_SPEECH
  TRANSLATION
  SENTIMENT_ANALYSIS
}

// Core Models
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  firstName          String
  lastName           String
  name               String?
  role               UserRole
  isActive            Boolean  @default(true)
  subscriptionStatus String?
  lastLoginAt        DateTime?
  lastActiveAt       DateTime?
  grade              Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  student            Student?
  parent             Parent?
  teacher            Teacher?
  coach              Coach?
  admin              Admin?
  classes            Class[]
  notificationPreferences NotificationPreferences?
  userActivities     UserActivity[]
  aiLogs             AILog[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]
  notifications      Notification[]
  twoFactorAuth      TwoFactorAuth?
  passwordReset      PasswordReset[]
  emailVerification  EmailVerification?
  analyses           Analysis[]
  studySessions      StudySession[]
  subscriptions      Subscription[]
  familyMembers      FamilyMember[] @relation("UserFamilyMembers")
  childFamilyMembers FamilyMember[] @relation("UserChildFamilyMembers")
  plans              Plan[]
  achievements       Achievement[]
  parentReports      ParentReport[]

  @@map("users")
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  studentId   String   @unique
  grade       Int
  school      String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Parent?         @relation(fields: [parentId], references: [id])
  classStudents  ClassStudent[]
  submissions    Submission[]
  studyPlans     StudyPlan[]
  achievements   Achievement[]
  tasks          Task[]
  payments       Payment[]
  subscriptions  Subscription[]
  studentProfile StudentProfile?
  quizResults    QuizResult[]
  examResults    ExamResult[]
  coachNotes     CoachNote[]
  familyMembers  FamilyMember[]
  parentReports  ParentReport[]

  @@map("students")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students  Student[]

  @@map("parents")
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  subject   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

model Coach {
  id        String   @id @default(cuid())
  userId    String   @unique
  specialty String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coaches")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  level     Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// Educational Models
model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  grade       Int
  subject     String
  teacherId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  teacher     User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  students    ClassStudent[]

  @@index([teacherId])
  @@index([grade])
  @@index([subject])
  @@map("classes")
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt   DateTime @default(now())
  isActive  Boolean  @default(true)

  // Relations
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@map("class_students")
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  classId     String
  dueDate     DateTime
  maxScore    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  class      Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([classId])
  @@index([dueDate])
  @@map("assignments")
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String
  submittedAt  DateTime @default(now())
  isLate       Boolean  @default(false)
  score        Int?

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  score        Int
  feedback     String?
  gradedAt     DateTime @default(now())
  gradedBy     String

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("grades")
}

model StudyPlan {
  id        String   @id @default(cuid())
  studentId String
  title     String
  content   String
  type      PlanType
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("study_plans")
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subjects")
}

// Notification Models
model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  category  NotificationCategory
  title     String
  message   String
  read      Boolean            @default(false)
  createdAt DateTime           @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([category])
  @@map("notifications")
}

model NotificationPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  achievementAlerts    Boolean  @default(true)
  progressAlerts        Boolean  @default(true)
  systemAlerts          Boolean  @default(true)
  securityAlerts        Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationCampaign {
  id            String   @id @default(cuid())
  name          String
  description   String?
  templateId    String?
  targetUsers   String[]
  targetCriteria Json?
  status        String   @default("draft")
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@map("notification_campaigns")
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  content   String
  type      NotificationType
  category  NotificationCategory
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaigns NotificationCampaign[]

  @@map("notification_templates")
}

// Payment Models
model Payment {
  id            String        @id @default(cuid())
  studentId     String
  subscriptionId String?
  amount        Decimal
  currency      String        @default("TRY")
  status        PaymentStatus
  paymentMethod String
  transactionId String?
  description   String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("payments")
}

model Subscription {
  id        String             @id @default(cuid())
  studentId String
  userId    String?
  planId    String
  planType  String?
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([studentId])
  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// Achievement and Task Models
model Achievement {
  id          String           @id @default(cuid())
  studentId   String
  userId      String?
  type        AchievementType
  title       String
  description String
  points      Int              @default(0)
  icon        String?
  unlockedAt  DateTime         @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([userId])
  @@index([type])
  @@map("achievements")
}

model Task {
  id          String   @id @default(cuid())
  studentId   String
  type        TaskType
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([type])
  @@map("tasks")
}

// Security Models
model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String?
  type      SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([ipAddress])
  @@map("security_events")
}

model SecurityThreat {
  id        String             @id @default(cuid())
  type      String
  level     SecurityThreatLevel
  source    String
  target    String?
  details   Json
  status    String             @default("active")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([type])
  @@index([level])
  @@index([status])
  @@map("security_threats")
}

model SecurityAlert {
  id        String   @id @default(cuid())
  title     String
  message   String
  level     SecurityThreatLevel
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([level])
  @@index([isRead])
  @@map("security_alerts")
}

model BlockedIP {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String
  blockedAt DateTime @default(now())
  expiresAt DateTime?

  @@index([ipAddress])
  @@map("blocked_ips")
}

// AI Models
model AIService {
  id            String          @id @default(cuid())
  name          String          @unique
  description   String?
  endpoint      String
  status        AIServiceStatus @default(ACTIVE)
  config        Json?
  lastActivity  DateTime?
  responseTime  Int?
  requests      Int             @default(0)
  tokens        Int             @default(0)
  cost          Decimal         @default(0)
  cpuUsage      Float           @default(0)
  memoryUsage   Float          @default(0)
  uptime        Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  models AIModel[]
  logs   AILog[]

  @@map("ai_services")
}

model AIModel {
  id          String      @id @default(cuid())
  serviceId   String
  name        String
  type        AIModelType
  version     String
  config      Json?
  isActive    Boolean     @default(true)
  status      String      @default("active")
  accuracy    Float       @default(0)
  lastTrained DateTime?
  requests    Int         @default(0)
  tokens      Int         @default(0)
  cost        Decimal     @default(0)
  responseTime Int        @default(0)
  successRate Float       @default(0)
  errorRate   Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  service AIService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  logs    AILog[]

  @@index([serviceId])
  @@index([type])
  @@map("ai_models")
}

model AILog {
  id        String   @id @default(cuid())
  userId    String?
  serviceId String
  modelId   String?
  request   Json
  response  Json?
  status   String
  duration  Int?
  timestamp DateTime @default(now())
  action    String?
  input     Json?
  output    Json?
  tokens    Int?
  cost      Decimal?
  error     String?
  createdAt DateTime @default(now())

  // Relations
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  service AIService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  model   AIModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([serviceId])
  @@index([modelId])
  @@index([status])
  @@map("ai_logs")
}

model AIAlert {
  id        String   @id @default(cuid())
  title     String
  message   String
  level     String
  type      String?
  timestamp DateTime @default(now())
  resolved  Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([level])
  @@index([isRead])
  @@index([resolved])
  @@map("ai_alerts")
}

model AIPromptTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     String
  category    String?
  tags        String[]
  template    String?
  variables   String[]
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("ai_prompt_templates")
}

// System Models
model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@map("system_logs")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  resource  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("user_activities")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@map("audit_logs")
}

// Report Models
model Report {
  id        String       @id @default(cuid())
  title     String
  type      String
  status    ReportStatus  @default(PENDING)
  data      Json?
  filePath  String?
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([type])
  @@map("reports")
}

model ReportTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String
  config      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@map("report_templates")
}

// Rate Limiting Models
model RateLimitRule {
  id          String   @id @default(cuid())
  name        String
  pattern     String
  limit       Int
  window      Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rate_limit_rules")
}

model RateLimitLog {
  id        String   @id @default(cuid())
  ipAddress String
  endpoint  String
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ipAddress])
  @@index([endpoint])
  @@map("rate_limit_logs")
}

// Feature Flag Models
model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(false)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  evaluations FeatureFlagEvaluation[]

  @@map("feature_flags")
}

model FeatureFlagEvaluation {
  id        String   @id @default(cuid())
  flagId    String
  userId    String?
  result    Boolean
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
  @@index([userId])
  @@map("feature_flag_evaluations")
}

// Authentication Models
model TwoFactorAuth {
  id        String   @id @default(cuid())
  userId    String   @unique
  secret    String
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verifications")
}

// Analysis Models
model Analysis {
  id        String   @id @default(cuid())
  userId    String
  type      String
  subject   String?
  score     Float?
  data      Json
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([subject])
  @@map("analyses")
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal
  planType    String
  features    Json?
  status      String   @default("ACTIVE")
  isActive    Boolean  @default(true)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions    StudySession[]

  @@map("plans")
}

model StudySession {
  id          String   @id @default(cuid())
  userId      String
  planId      String?
  subject     String
  duration    Int
  isCompleted Boolean  @default(false)
  status      String   @default("PENDING")
  performance Float?
  score       Float?
  startTime   DateTime?
  completedAt DateTime?
  topic       String?
  createdAt   DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subject])
  @@index([isCompleted])
  @@index([status])
  @@map("study_sessions")
}

// Machine Learning Models
model MLModel {
  id          String   @id @default(cuid())
  name        String
  type        String
  version     String
  status      String   @default("active")
  accuracy    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  predictions MLPrediction[]
  trainingJobs MLTrainingJob[]

  @@map("ml_models")
}

model MLPrediction {
  id        String   @id @default(cuid())
  modelId   String
  input     Json
  output    Json
  confidence Float?
  createdAt DateTime @default(now())

  // Relations
  model MLModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("ml_predictions")
}

model MLTrainingJob {
  id        String   @id @default(cuid())
  modelId   String
  status    String   @default("pending")
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  model MLModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("ml_training_jobs")
}

model MLRecommendation {
  id        String   @id @default(cuid())
  userId    String
  type      String
  data      Json
  score     Float
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("ml_recommendations")
}

// Backup Models
model BackupJob {
  id        String   @id @default(cuid())
  status    String   @default("pending")
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("backup_jobs")
}

model RestoreJob {
  id        String   @id @default(cuid())
  status    String   @default("pending")
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restore_jobs")
}

model BackupSchedule {
  id        String   @id @default(cuid())
  name      String
  schedule  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("backup_schedules")
}

// Additional Models
model StudentProfile {
  id        String   @id @default(cuid())
  studentId String   @unique
  bio       String?
  avatar    String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model QuizResult {
  id        String   @id @default(cuid())
  studentId String
  userId    String
  quizId    String
  score     Float
  totalScore Float?
  answers   Json
  createdAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([userId])
  @@map("quiz_results")
}

model ExamResult {
  id        String   @id @default(cuid())
  studentId String
  userId    String
  examId    String
  score     Float
  answers   Json
  createdAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([userId])
  @@map("exam_results")
}

model CoachNote {
  id           String   @id @default(cuid())
  studentId    String
  coachId      String
  coachStudent String?
  content      String
  createdAt    DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([coachStudent])
  @@map("coach_notes")
}

model FamilyMember {
  id        String   @id @default(cuid())
  studentId  String
  childId    String?
  parentId   String
  relation   String
  role       String?
  createdAt  DateTime @default(now())

  // Relations
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent     User?   @relation("UserFamilyMembers", fields: [parentId], references: [id], onDelete: Cascade)
  child      User?   @relation("UserChildFamilyMembers", fields: [childId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([childId])
  @@map("family_members")
}

// Parent Report Model
model ParentReport {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  title     String
  content   String
  type      String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([studentId])
  @@index([type])
  @@map("parent_reports")
}

// Log Entry Model
model LogEntry {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  source    String?
  timestamp DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([timestamp])
  @@map("log_entries")
}

