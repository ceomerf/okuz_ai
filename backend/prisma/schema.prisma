// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleType {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum PlanType {
  DAILY
  WEEKLY
  MONTHLY
  HOLIDAY
  LONG_TERM
}

enum AchievementType {
  STUDY_STREAK
  PERFECT_SCORE
  COMPLETION
  MILESTONE
  SPECIAL
}

enum TaskType {
  STUDY_SESSION
  QUIZ
  EXAM
  PROJECT
  READING
  PRACTICE
}

enum NotificationType {
  REMINDER
  ACHIEVEMENT
  PROGRESS
  SYSTEM
  INVITE
}

enum SubscriptionStatus {
  TRIAL
  FREE
  PREMIUM
  FAMILY
  CANCELLED
}

enum SubscriptionPlan {
  MONTHLY_PREMIUM
  YEARLY_PREMIUM
  FAMILY_PLAN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// Ek sınav türleri için enum (YKS odaklı ancak genişletilebilir)
enum ExamType {
  TYT
  AYT
  LGS
  KPSS
}

model YksTopic {
  id        String   @id @default(cuid())
  subject   String
  grade     Int
  topic     String
  subtopic  String?
  difficulty String  @default("medium")
  weight    Float   @default(1.0)
  track     String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject, grade])
  @@index([subject, topic])
  @@index([isActive])
}

model UserUsageControl {
  id                 String   @id @default(cuid())
  userId             String   @unique
  monthlyTokenLimit  Int      @default(1000000)
  monthlyTokenUsed   Int      @default(0)
  lastResetAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([isRevoked])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRoleType @default(STUDENT)
  refreshToken String?
  resetToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Usage fields
  dailyUsage   Int @default(0)
  weeklyUsage  Int @default(0)
  monthlyUsage Int @default(0)
  dailyLimit   Int @default(100)
  weeklyLimit  Int @default(500)
  monthlyLimit Int @default(2000)

  // Additional user fields
  grade         Int?
  lastActiveAt  DateTime?

  // Subscription fields
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialEndDate        DateTime?
  subscriptionEndDate DateTime?

  @@index([email])
  @@index([subscriptionStatus])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastActiveAt])

  // Profile relations (moved to Student/Parent relations section)

  // Invites
  sentInvites     Invite[] @relation("Inviter")
  receivedInvites Invite[] @relation("Invitee")

  // Plans
  plans Plan[]

  // Achievements
  achievements Achievement[]

  // Study sessions
  studySessions StudySession[]

  // Quiz results
  quizResults QuizResult[]

  // Gamification
  gamificationProfile GamificationProfile?

  // Notifications
  notifications Notification[]

  // Tool usage
  toolUsages ToolUsage[]

  // Family connections
  familyMembers FamilyMember[] @relation("Parent")
  children      FamilyMember[] @relation("Child")

  // Additional relations
  examResults   ExamResult[]
  learningPaths LearningPath[]
  flashcards    Flashcard[]
  conceptMaps   ConceptMap[]
  quizzes       Quiz[] @relation("UserQuizzes")
  studyGoals    StudyGoal[]
  studyHabits   StudyHabit[]
  subscriptions Subscription[]
  payments      Payment[]

  // Back-relation: Weekly metrics
  weeklyMetrics StudentWeeklyMetrics[]
  
  // Usage control
  usageCtrl UserUsageControl?

  // Refresh tokens
  refreshTokens RefreshToken[]
  
  // AI relations
  aiRequestLogs AiRequestLog[]
  aiUsageAnalytics AiUsageAnalytics[]
  
  // Notification relations
  pushDevices PushDevice[]
  notificationPreferences NotificationPreference[]
  
  // Performance and Coaching relations
  performanceHistory StudentPerformanceHistory[]
  performanceAnalyses PerformanceAnalysis[]
  weeklyProgressReports WeeklyProgressReport[]
  coachingRecommendations CoachingRecommendation[]
  studyStreak StudyStreak?

  // Additional relations
  assessments Assessment[]

  // Smart Tools relations
  quickChats QuickChat[]
  sosQuestions SosQuestion[]
  summaries SummaryGenerator[]
  
  // YKS subjects for students
  yksSubjects String[]

  // Sprint 1: Koç paneli ve veli raporları
  coachStudents CoachStudent[] @relation("Coach")
  studentCoaches CoachStudent[] @relation("Student")
  studentCompliance StudentCompliance[]
  parentReports ParentWeeklyReport[] @relation("ParentReport")
  studentReports ParentWeeklyReport[] @relation("StudentReport")
  aiCoachDaily AICoachDaily[]
  notificationSettings NotificationSettings?
  notificationSnoozes NotificationSnooze[]
  referralCodes ReferralCode[] @relation("Referrer")
  referralUses ReferralUse[] @relation("ReferralUser")
  
  // Outbox events
  outboxEvents OutboxEvent[]
  
  // AI Coaching relations
  emotionalStates EmotionalState[]
  studentJournals StudentJournal[]
  emotionalInsights EmotionalInsight[]
  motivationalContents MotivationalContent[]
  personalizedRecommendations PersonalizedRecommendation[]
  textAnalyses TextAnalysis[]
  behaviorPatterns BehaviorPattern[]
  behaviorInsights BehaviorInsight[]
  behaviorPredictions BehaviorPrediction[]
  behaviorRecommendations BehaviorRecommendation[]
  contextAwareRecommendations ContextAwareRecommendation[]
  socialInteractions SocialInteraction[]
  wellnessData WellnessData[]
  
  // Additional AI relations
  proactiveRecommendations ProactiveRecommendation[]
  userActivities UserActivity[]
  progressRecords Progress[]
  userFeedbacks UserFeedback[]
  aiExplanations AIExplanation[]
  
  // Analysis relations
  analyses Analysis[]
  
  // RBAC relations
  roles UserRole[]
  
  // Advanced Analytics relations
  dashboards Dashboard[]
  analyticsQueries AnalyticsQuery[]
  
  // Additional relations
  interactions Interaction[]
  usageRecords Usage[]
  
  // Student/Parent relations
  studentProfile Student?
  parentProfile Parent?
  
  // Profile relations
  studentProfileData StudentProfile?
  parentProfileData ParentProfile?
}

model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  grade             Int
  field             String
  goals             String[]
  learningStyle     String?
  strengths         String[]
  weaknesses        String[]
  interests         String[]
  selectedSubjects  String[]
  performanceMetrics Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id         String    @id @default(cuid())
  inviterId  String
  inviteeId  String?
  email      String
  token      String    @unique
  type       String    // "student" or "parent"
  role       String?   // "STUDENT", "PARENT", "TEACHER"
  status     String    @default("pending") // "pending", "accepted", "expired", "declined"
  expiresAt  DateTime
  acceptedAt DateTime?
  declinedAt DateTime?
  resentAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  inviter User? @relation("Inviter", fields: [inviterId], references: [id])
  invitee User? @relation("Invitee", fields: [inviteeId], references: [id])
}

model Plan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  type        PlanType
  planType    String?  // Eksik property eklendi
  targetExam  String?  // Target exam field added
  subjects    String[]
  goals       String[]
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  status      String?  // ACTIVE, COMPLETED, CANCELLED
  metadata    Json?
  totalSessions Int?   // Eksik alan eklendi
  duration   Int?      // Plan süresi (gün cinsinden)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions StudySession[] @relation("PlanSessions")

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, startDate])
  @@index([userId, createdAt])
  @@index([userId, type, isActive, endDate])
  @@index([isActive, endDate])
  @@index([type, isActive])
  @@index([startDate, endDate])
  @@index([subjects])
  @@index([goals])
}

model StudySession {
  id          String    @id @default(cuid())
  planId      String?
  userId      String
  subject     String
  topic       String
  duration    Int // minutes
  difficulty  String?   // Eksik property eklendi
  type        String?   // Session type field added
  order       Int?      // Eksik property eklendi
  startTime   DateTime
  endTime     DateTime?
  isCompleted Boolean   @default(false)
  status      String?   // COMPLETED, IN_PROGRESS, CANCELLED
  performance Int? // 0-100
  notes       String?
  metadata    Json?
  objectives  String[]  // Objectives field added
  resources   String[]  // Resources field added
  techniques  String[]  // Techniques field added
  dayOfWeek   String?   // dayOfWeek field added
  completedAt DateTime? // completedAt field added
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  plan Plan? @relation("PlanSessions", fields: [planId], references: [id])
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([startTime])
  @@index([userId, startTime])
  @@index([userId, createdAt])
  @@index([planId, startTime])
  @@index([userId, isCompleted, startTime])
  @@index([subject, topic])
  @@index([userId, subject, startTime])
  @@index([userId, isCompleted, performance])
  @@index([startTime, endTime])
  @@index([performance])
  @@index([subject, performance])
}

model QuizResult {
  id         String   @id @default(cuid())
  userId     String
  subject    String
  topic      String?
  score      Int
  totalScore Int
  percentage Float
  completedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, subject])
  @@index([completedAt])
  @@index([percentage])
}

model ProactiveRecommendation {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  priority    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isActive])
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  activity    String
  metadata    Json?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activity])
  @@index([timestamp])
  @@index([createdAt])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  progress    Float
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject])
  @@index([createdAt])
}

model UserFeedback {
  id             String   @id @default(cuid())
  userId         String
  feedback       String
  rating         Int?
  metadata       Json?
  recommendationId String?
  helpful        Boolean?
  accurate       Boolean?
  clear          Boolean?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@index([recommendationId])
}

model AIExplanation {
  id          String   @id @default(cuid())
  userId      String
  explanation String
  context     Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Achievement {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String
  type        AchievementType
  icon        String?
  points      Int             @default(0)
  metadata    Json?
  unlockedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model GamificationProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  level            Int      @default(1)
  experience       Int      @default(0)
  energy           Int      @default(100)
  maxEnergy        Int      @default(100)
  streak           Int      @default(0)
  totalPoints      Int      @default(0)
  coins            Int      @default(0)
  lastEnergyRefill DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@index([userId, isRead])
   @@index([userId, type])
   @@index([userId, createdAt])
   @@index([isRead])
   @@index([type])
   @@index([createdAt])
}

model ToolUsage {
  id        String   @id @default(cuid())
  userId    String
  toolName  String
  input     String?
  output    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model FamilyMember {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  role      String // "parent", "child"
  createdAt DateTime @default(now())

  parent User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("Child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

model ExamResult {
  id         String   @id @default(cuid())
  userId     String
  subject    String
  examType   String
  score      Int
  totalScore Int
  duration   Int // minutes
  answers    Json?
  analysis   Json?
  topic      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, examType, createdAt])
}

model LearningPath {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  subjects    String[]
  topics      String[]
  steps       Json
  progress    Json?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Flashcard {
  id           String    @id @default(cuid())
  userId       String
  topic        String
  front        String
  back         String
  difficulty   String    @default("medium")
  isMastered   Boolean   @default(false)
  lastReviewed DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConceptMap {
  id          String   @id @default(cuid())
  userId      String
  topic       String
  concepts    Json
  connections Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Quiz {
  id          String    @id @default(cuid())
  userId      String
  topic       String
  questions   Json
  answers     Json?
  score       Int?
  totalScore  Int
  duration    Int // minutes
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation("UserQuizzes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model StudyGoal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  target      Int
  current     Int       @default(0)
  unit        String // "hours", "pages", "questions", etc.
  deadline    DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyHabit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  frequency   String // "daily", "weekly", "monthly"
  target      Int
  current     Int      @default(0)
  streak      Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Analysis model for performance analytics
model Analysis {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  topic       String?
  difficulty  String?
  performance Float
  score       Int?
  totalScore  Int?
  duration    Int?     // minutes
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject])
  @@index([performance])
  @@index([createdAt])
}

/// Outbox pattern for reliable event publishing to WS/queues
model OutboxEvent {
  id             String   @id @default(cuid())
  userId         String
  aggregateType  String   // e.g., "plan" | "session"
  aggregateId    String
  eventType      String   // e.g., "PLAN_CREATED", "SESSION_UPDATED"
  eventVersion   Int      @default(1)
  payload        Json
  status         String   @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  processed      Boolean  @default(false)
  attemptCount   Int      @default(0)
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([userId, createdAt])
  @@index([processed])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planType  SubscriptionPlan
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean            @default(true)
  features  String[]
  amount    Float?              // amount field added
  metadata  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  subscriptionId  String?
  amount          Float
  currency        String        @default("TRY")
  status          PaymentStatus @default(PENDING)
  paymentMethod   String // "credit_card", "bank_transfer", etc.
  transactionId   String? // External payment gateway transaction ID
  gatewayResponse Json? // Full response from payment gateway
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
}

/// MEB müfredat konuları ve YKS ağırlıklarını tutar
model MebTopic {
  id        String   @id @default(cuid())
  grade     Int      // Konunun ait olduğu sınıf (9, 10, 11, 12)
  subject   String   // Dersin normalize edilmiş adı (Örn: "Matematik", "Türkçe")
  unit      String   // Ünitenin/temanın adı (Örn: "Sayılar ve Cebir")
  topic     String   // Konunun adı (Örn: "Üslü İfadeler ve Denklemler")
  
  // YENİ VE GELİŞMİŞ ALANLAR
  month     Int?     // Konunun işlendiği ay (9=Eylül, 10=Ekim, ..., 6=Haziran)
  officialSubjectName String? // MEB'deki resmi adı (örn: "İleri Matematik")
  modelYear String?  // Müfredat yılı (örn: "2025-2026 Maarif Modeli")
  
  // YKS ağırlıkları
  outcomes  String[] // Bu konuya ait MEB kazanımları (opsiyonel)
  tytWeight Int      @default(0) // Konunun TYT'deki ortalama soru sayısı
  aytWeight Int      @default(0) // Konunun AYT'deki ortalama soru sayısı

  // İLİŞKİLER (Hafıza için)
  // Eski tekil örnek ilişki alanları korunabilir; çoklu önşartlar için aşağıdaki relation'lar kullanılır

  // TopicPrerequisite back-relations
  asTopicPrerequisites     TopicPrerequisite[] @relation("TP_Topic")
  asPrerequisiteOf         TopicPrerequisite[] @relation("TP_Prerequisite")

  // TopicWeight back-relation
  weights                  TopicWeight[]

  @@unique([grade, subject, topic, modelYear])
}

/// Konu ön-şart ilişkilerini çoklu (N-N) biçimde tutar
model TopicPrerequisite {
  id              String   @id @default(cuid())

  // İlişkiler: topic ve prerequisiteTopic doğrudan MebTopic ile ilişkilidir
  topicId         String
  prerequisiteId  String

  topic           MebTopic @relation("TP_Topic", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite    MebTopic @relation("TP_Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now())

  @@unique([topicId, prerequisiteId])
  @@index([topicId])
  @@index([prerequisiteId])
}

/// Sınav türüne göre konu ağırlıkları ve zorluk dağılımını tutar
model TopicWeight {
  id             String    @id @default(cuid())
  mebTopicId     String
  examType       ExamType
  weight         Float     // Ortalama soru sayısı veya ağırlık skoru
  difficultyDist Json      // Zorluk dağılımı (örn: {"easy":0.2,"medium":0.6,"hard":0.2})

  mebTopic       MebTopic  @relation(fields: [mebTopicId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())

  @@unique([mebTopicId, examType])
  @@index([examType])
}

/// Öğrencinin haftalık metriklerini (tamamlama, öz-bildirim, mini test) takip eder
model StudentWeeklyMetrics {
  id               String   @id @default(cuid())
  userId           String
  weekStart        DateTime // ISO8601; haftanın ilk günü (örn: Pazartesi 00:00)

  // İsteğe bağlı ders kırılımı; toplam metrikler için null bırakılabilir
  subject          String?

  tasksCompleted   Int      @default(0)
  tasksSkipped     Int      @default(0)
  avgSelfReport    Int      @default(0) // 1-5 ölçeğinde
  avgQuizScore     Int      @default(0) // 0-100 arası

  metadata         Json?
