# Production Environment Variables for VPS

# Database - Docker için
DATABASE_URL="postgresql://postgres:password@db:5432/okuz_ai"
REDIS_URL="redis://redis:6379"

# JWT Configuration
JWT_SECRET="okuz-ai-super-secret-jwt-key-production-2025-secure"
JWT_REFRESH_SECRET="okuz-ai-super-secret-refresh-key-production-2025-secure"
JWT_EXPIRES_IN="15m"

# Server Configuration
PORT=3002
NODE_ENV=production

# CORS - Allow all origins for production
CORS_ORIGINS="*"

# Google Gemini API
GEMINI_API_KEY="AIzaSyDFYIVzHB1UuLC2zcD1_iWuBFxG38GRnkE"
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API
OPENAI_API_KEY="your-openai-api-key-here"

# Monitoring
PROMETHEUS_PORT=9090
SWAGGER_ENABLE=true

# PM2 Configuration
PM2_NAME="okuz-api"
PM2_INSTANCES="max"
PM2_EXEC_MODE="cluster" 
