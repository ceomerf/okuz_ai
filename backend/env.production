# Production Environment Configuration
# Okuz AI - Production Settings

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
PORT=3002
API_VERSION=v1

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=postgresql://okuz_user:production_password@prod-db:5432/okuz_ai_prod
PLANNING_DATABASE_URL=postgresql://okuz_user:production_password@prod-db:5432/okuz_ai_planning_prod
SMART_TOOLS_DATABASE_URL=postgresql://okuz_user:production_password@prod-db:5432/okuz_ai_smart_tools_prod
GAMIFICATION_DATABASE_URL=postgresql://okuz_user:production_password@prod-db:5432/okuz_ai_gamification_prod
NOTIFICATION_DATABASE_URL=postgresql://okuz_user:production_password@prod-db:5432/okuz_ai_notification_prod
AUTH_DATABASE_URL=postgresql://okuz_user:production_password@prod-db:5432/okuz_ai_auth_prod

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://prod-redis:6379
REDIS_PASSWORD=production_redis_password

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=production-jwt-secret-key-minimum-32-chars-for-production
JWT_REFRESH_SECRET=production-refresh-secret-key-minimum-32-chars-for-production
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=7d

# ===========================================
# AI SERVICES
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ALLOWED_ORIGINS=https://app.okuz.ai,https://admin.okuz.ai

# ===========================================
# RATE LIMITING
# ===========================================
THROTTLER_SHORT_TTL=60000
THROTTLER_SHORT_LIMIT=5
THROTTLER_MEDIUM_TTL=60000
THROTTLER_MEDIUM_LIMIT=20
THROTTLER_LONG_TTL=60000
THROTTLER_LONG_LIMIT=100

# ===========================================
# SERVICE DISCOVERY
# ===========================================
PLANNING_SERVICE_URL=http://planning-service:3001
SMART_TOOLS_SERVICE_URL=http://smart-tools-service:3002
GAMIFICATION_SERVICE_URL=http://gamification-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004
AUTH_SERVICE_URL=http://auth-service:3005

# ===========================================
# EVENT BUS CONFIGURATION
# ===========================================
EVENT_BUS_URL=prod-kafka:9092
EVENT_BUS_TOPIC=okuz-ai-events-prod
MESSAGE_QUEUE_URL=prod-kafka:9092
MESSAGE_QUEUE_TOPIC=okuz-ai-queue-prod

# ===========================================
# CIRCUIT BREAKER
# ===========================================
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ===========================================
# LOAD BALANCER
# ===========================================
LOAD_BALANCER_STRATEGY=least-connections

# ===========================================
# MONITORING
# ===========================================
PROMETHEUS_PORT=9090
SWAGGER_ENABLE=false
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=warn
LOG_FORMAT=json

# ===========================================
# EXTERNAL SERVICES
# ===========================================
EMAIL_SERVICE_URL=http://email-service:3006
PUSH_NOTIFICATION_SERVICE_URL=http://push-service:3007

# ===========================================
# PRODUCTION SPECIFIC
# ===========================================
DEBUG=false
HOT_RELOAD=false
MOCK_EXTERNAL_SERVICES=false
ENABLE_TEST_DATA=false
ENABLE_DEBUG_ENDPOINTS=false