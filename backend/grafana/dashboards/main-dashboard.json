{
  "dashboard": {
    "id": null,
    "title": "Okuz AI - Ana API Dashboard",
    "tags": ["okuz-ai", "api", "main"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "API Genel Sağlık Durumu",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"okuz-ai-backend\"}",
            "legendFormat": "Backend Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "HTTP İstek Sayısı (Son 1 Saat)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"okuz-ai-backend\"}[5m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Hata Oranı (%)",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"okuz-ai-backend\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"okuz-ai-backend\"}[5m]) * 100",
            "legendFormat": "5xx Error Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Ortalama Yanıt Süresi",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(http_request_duration_seconds_sum{job=\"okuz-ai-backend\"}[5m]) / rate(http_request_duration_seconds_count{job=\"okuz-ai-backend\"}[5m])",
            "legendFormat": "Avg Response Time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 2}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
      },
      {
        "id": 5,
        "title": "Aktif Kullanıcı Sayısı",
        "type": "stat",
        "targets": [
          {
            "expr": "active_users_gauge{job=\"okuz-ai-backend\"}",
            "legendFormat": "Active Users"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
      },
      {
        "id": 6,
        "title": "HTTP Durum Kodları Dağılımı",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (status) (rate(http_requests_total{job=\"okuz-ai-backend\"}[5m]))",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "En Popüler Endpoint'ler",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum by (endpoint) (rate(http_requests_total{job=\"okuz-ai-backend\"}[5m])))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 8,
        "title": "Yanıt Süresi Histogramı",
        "type": "heatmap",
        "targets": [
          {
            "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"okuz-ai-backend\"}[5m])) by (le)",
            "legendFormat": "{{le}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
