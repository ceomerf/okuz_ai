      sourcesContent: ["import { Injectable, Logger, BadRequestException } from '@nestjs/common';\nimport { PrismaService } from '../../common/prisma/prisma.service';\n\nexport interface PlanValidationResult {\n  isValid: boolean;\n  errors: string[];\n  warnings: string[];\n  suggestions: string[];\n}\n\nexport interface PlanStructure {\n  title: string;\n  description: string;\n  subjects: string[];\n  goals: string[];\n  weeks?: any[];\n  totalSessions?: number;\n  duration?: number;\n}\n\nexport interface SessionStructure {\n  subject: string;\n  topic: string;\n  duration: number;\n  difficulty: string;\n  type: string;\n  startTime: Date;\n  objectives?: string[];\n  resources?: string[];\n  techniques?: string[];\n}\n\n@Injectable()\nexport class PlanValidationService {\n  private readonly logger = new Logger(PlanValidationService.name);\n\n  constructor(private readonly prisma: PrismaService) {}\n\n  /**\n   * Plan yap\u0131s\u0131n\u0131 do\u011Frula\n   */\n  validatePlan(plan: PlanStructure): PlanValidationResult {\n    const errors: string[] = [];\n    const warnings: string[] = [];\n    const suggestions: string[] = [];\n\n    // Temel alanlar kontrol\xFC\n    if (!plan.title || plan.title.trim().length === 0) {\n      errors.push('Plan ba\u015Fl\u0131\u011F\u0131 bo\u015F olamaz');\n    }\n\n    if (!plan.description || plan.description.trim().length === 0) {\n      warnings.push('Plan a\xE7\u0131klamas\u0131 bo\u015F');\n    }\n\n    if (!plan.subjects || plan.subjects.length === 0) {\n      errors.push('En az bir ders se\xE7ilmelidir');\n    }\n\n    if (!plan.goals || plan.goals.length === 0) {\n      warnings.push('Plan hedefleri belirtilmemi\u015F');\n    }\n\n    // Ders adlar\u0131 kontrol\xFC\n    if (plan.subjects) {\n      const validSubjects = ['Matematik', 'Fizik', 'Kimya', 'Biyoloji', 'T\xFCrk\xE7e', 'Tarih', 'Co\u011Frafya', '\u0130ngilizce'];\n      const invalidSubjects = plan.subjects.filter(subject => !validSubjects.includes(subject))